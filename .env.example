# Copier en .env (jamais commité) puis remplir.
# Les deux dernières valeurs sont générées par : node server/hash-password.js

# Compte propriétaire : seul compte qui enregistre les traces sur le serveur
ADMIN_EMAIL=toi@example.com

# Hash scrypt du mot de passe (le mot de passe en clair n'est stocké nulle part)
ADMIN_PASSWORD_HASH=

# Secret de signature des sessions (le changer déconnecte toutes les sessions)
SESSION_SECRET=

# Cookie envoyé en HTTPS uniquement. Mettre false seulement en local sans HTTPS.
COOKIE_SECURE=true
